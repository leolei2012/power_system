      "inputs": 4,
      "description": "Inductor current, input voltage, output voltage and NTC; six ports remain."
    },
    "single_Vienna_PFC": {
      "inputs": 9,
      "description": "Three currents, three input voltages, two half-bus voltages and NTC; one port remains."
    },
    "assumptions": "One motor OR one PFC application; one power PWM port. Do not sum motor and PFC channels.",
